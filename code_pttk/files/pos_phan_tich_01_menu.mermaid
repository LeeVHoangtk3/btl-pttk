namespace MenuPackage {
    class Category {
        maDanhMuc
        tenDanhMuc
        moTa
    }

    class MenuItem {
        <<abstract>>
        maMon
        tenMon
        gia
        hinhAnh
        dangKinhDoanh
    }

    class Dish {
        loaiMon
        moTa
    }

    class Combo {
        soLuongNguoiAn
    }

    class ComboDetail {
        soLuong
        ghiChu
    }
}

Category "1" -- "*" MenuItem : phan loai
MenuItem <|-- Dish : la mot
MenuItem <|-- Combo : la mot

Combo "1" *-- "1..*" ComboDetail : gom
ComboDetail "*" --> "1" Dish : chua mon le