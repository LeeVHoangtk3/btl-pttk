classDiagram
%% ===================================================================
%% CLASS DIAGRAM - PHA PHAN TICH (ANALYSIS)
%% Chi gom cac lop thuc the (domain concept), khong Boundary/Control,
%% khong phuong thuc, thuoc tinh rut gon (khong kieu du lieu / visibility)
%% ===================================================================

namespace MenuPackage {
    class Category {
        maDanhMuc
        tenDanhMuc
        moTa
    }

    class MenuItem {
        <<abstract>>
        maMon
        tenMon
        gia
        hinhAnh
    }

    class Dish {
        loaiMon
        moTa
    }

    class Combo {
        soLuongNguoiAn
    }

    class ComboDetail {
        soLuong
        ghiChu
    }
}

Category "1" -- "*" MenuItem : thuoc danh muc
MenuItem <|-- Dish : la mot
MenuItem <|-- Combo : la mot
Combo "1" *-- "1..*" ComboDetail : gom
ComboDetail "*" --> "1" Dish : mon con


namespace OrderPackage {
    class Area {
        maKhuVuc
        tenKhuVuc
    }

    class Table {
        maBan
        soBan
        trangThai
    }

    class Order {
        maDon
        thoiGianTao
        trangThai
        tongTien
        vat
        chietKhau
    }

    class OrderTaiCho {
        ban
    }

    class OrderMangVe {
        diaChiGiao
        soDienThoaiKhach
    }

    class OrderItem {
        soLuong
        donGia
        ghiChu
        tuyChon
    }
}

Area "1" -- "*" Table : quan ly
Order <|-- OrderTaiCho
Order <|-- OrderMangVe
Order "1" *-- "1..*" OrderItem : gom mon
OrderItem "*" --> "1" MenuItem : tham chieu
OrderTaiCho "1" -- "1" Table : phuc vu dung 1 ban


namespace ThanhToanPackage {
    class Payment {
        maThanhToan
        tongTienDon
        thoiGianThanhToan
    }

    class PaymentTienMat {
        tienDaNhan
        tienThua
        tienTip
    }

    class PaymentThe {
        loaiThe
        maGiaoDich
    }

    class LoaiThe {
        <<enumeration>>
        VISA
        MASTER
        JCB
        ATM
    }

    class PaymentLog {
        maLog
        maDon
        tongTien
        thoiGian
        nhanVien
    }
}

Payment <|-- PaymentTienMat
Payment <|-- PaymentThe
PaymentThe --> LoaiThe
Order "1" -- "0..1" Payment : duoc thanh toan
Payment "1" --> "1" PaymentLog : luu log