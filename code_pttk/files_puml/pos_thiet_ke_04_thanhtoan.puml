@startuml

' =========================
' STYLE (VISUAL PARADIGM)
' =========================
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho

' Khoang cach deu giua cac bang
skinparam nodesep 65
skinparam ranksep 65

skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontColor #111111

' Chi ten class in dam
skinparam classFontStyle bold

skinparam class {
   BackgroundColor #7ACFF5
   BorderColor #000000
   BorderThickness 1

   FontColor #111111
   AttributeFontColor #111111

   ArrowColor #000000
   StereotypeFontColor #111111
}

skinparam package {
   BackgroundColor #FFFFFF
   BorderColor #000000
   BorderThickness 1
   FontStyle bold
}

hide circle

' ===================================================================
' CLASSES (DESIGN PHASE) - PACKAGE: THANH TOAN
' ===================================================================
package "ThanhToanPackage" {
    class PaymentUI {
       --
       + hienThiDanhSachDonChoThanhToan() : void
       + chonPhuongThucThanhToan() : void
       + nhapSoTienNhan(soTien: double) : void
    }

    class PaymentController {
       --
       + chonDonThanhToan(don: Order) : Payment
       + chonPhuongThuc(loaiPt: String) : Payment
       + xuLyThanhToan(payment: Payment) : bool
       + xoaDonSauThanhToan(don: Order) : bool
       + luuLichSu(payment: Payment) : bool
    }

    class Payment {
       # maThanhToan : String
       # tongTienDon : double
       # thoiGianThanhToan : DateTime
       --
       + xacNhanThanhToan() : bool
    }

    class PaymentTienMat {
       - tienDaNhan : double
       - tienThua : double
       - tienTip : double
       --
       + tinhTienThua() : double
    }

    class PaymentThe {
       - loaiThe : LoaiThe
       - maGiaoDich : String
       --
       + xacThucThe() : bool
    }

    enum LoaiThe {
       VISA
       MASTER
       JCB
       ATM
    }

    class PaymentLog {
       - maLog : String
       - maDon : String
       - tongTien : double
       - thoiGian : DateTime
       - nhanVien : String
    }

    class Order {
       ' Lop tham chieu tu package Order
    }
}

' =========================
' ASSOCIATIONS
' =========================
PaymentUI -down-> PaymentController
PaymentController -down-> Payment
PaymentController -down-> Order
PaymentController -right-> PaymentLog
Payment <|--down- PaymentTienMat
Payment <|--down- PaymentThe
PaymentThe -right-> LoaiThe
Order "1" --down- "0..1" Payment
Payment "1" -right-> "1" PaymentLog

@enduml
