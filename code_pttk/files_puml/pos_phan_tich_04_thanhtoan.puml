@startuml

' =========================
' STYLE (VISUAL PARADIGM)
' =========================
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho

' Khoang cach deu giua cac bang
skinparam nodesep 65
skinparam ranksep 65

skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontColor #111111

' Chi ten class in dam
skinparam classFontStyle bold

skinparam class {
   BackgroundColor #7ACFF5
   BorderColor #000000
   BorderThickness 1

   FontColor #111111
   AttributeFontColor #111111

   ArrowColor #000000
   StereotypeFontColor #111111
}

skinparam package {
   BackgroundColor #FFFFFF
   BorderColor #000000
   BorderThickness 1
   FontStyle bold
}

hide circle
' An toan bo phuong thuc de dung chuan pha phan tich
hide methods

' ===================================================================
' CLASSES (ANALYSIS PHASE) - PACKAGE: THANH TOAN
' ===================================================================
package "ThanhToanPackage" {
    class Payment {
       - maThanhToan
       - tongTienDon
       - thoiGianThanhToan
    }

    class PaymentTienMat {
       - tienDaNhan
       - tienThua
       - tienTip
    }

    class PaymentThe {
       - loaiThe
       - maGiaoDich
    }

    enum LoaiThe {
       VISA
       MASTER
       JCB
       ATM
    }

    class PaymentLog {
       - maLog
       - maDon
       - tongTien
       - thoiGian
       - nhanVien
    }

    class Order {
       ' Lop tham chieu tu package Order
    }
}

' =========================
' ASSOCIATIONS
' =========================
Payment <|--down- PaymentTienMat
Payment <|--down- PaymentThe
PaymentThe -right-> LoaiThe
Order "1" --down- "0..1" Payment
Payment "1" -right-> "1" PaymentLog

@enduml
