@startuml

' ===================================================================
' CLASS DIAGRAM - PHA THIET KE (DESIGN)
' Style: Visual Paradigm / Visual Diagram (vidu.puml)
' Day du kieu du lieu, visibility, phuong thuc, mau xanh dong nhat
' ===================================================================

' =========================
' STYLE
' =========================
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho

' Khoang cach deu giua cac bang
skinparam nodesep 65
skinparam ranksep 65

skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontColor #111111

' Chi ten class in dam
skinparam classFontStyle bold

skinparam class {
   BackgroundColor #7ACFF5
   BorderColor #000000
   BorderThickness 1

   FontColor #111111
   AttributeFontColor #111111

   ArrowColor #000000
   StereotypeFontColor #111111
}

skinparam package {
   BackgroundColor #FFFFFF
   BorderColor #000000
   BorderThickness 1
   FontStyle bold
}

hide circle

' ===================================================================
' NHOM 1: MENU (Da cap nhat lop Dish & chuan hoa Combo)
' ===================================================================
package "MenuPackage" {
    class MenuUI {
       --
       + hienThiDanhSachMon() : void
       + timKiemMon(tuKhoa: String) : void
       + hienThiFormThemSuaMon() : void
       + hienThiFormThemSuaCombo() : void
    }

    class MenuController {
       --
       + themMon(item: Dish) : bool
       + suaMon(item: Dish) : bool
       + xoaMon(maMon: String) : bool
       + themCombo(combo: Combo) : bool
       + suaCombo(combo: Combo) : bool
       + xoaCombo(maCombo: String) : bool
    }

    class Category {
       - maDanhMuc : String
       - tenDanhMuc : String
       - moTa : String
       --
       + getTenDanhMuc() : String
    }

    abstract class MenuItem {
       # maMon : String
       # tenMon : String
       # gia : double
       # hinhAnh : String
       # dangKinhDoanh : bool
       --
       + getGia() : double
       + getTenMon() : String
    }

    class Dish {
       - loaiMon : String
       - moTa : String
       --
       + getLoaiMon() : String
       + getMoTa() : String
    }

    class Combo {
       - soLuongNguoiAn : int
       --
       + themMonCon(mon: Dish, soLuong: int) : void
       + xoaMonCon(maMon: String) : void
       + tinhGiaCombo() : double
    }

    class ComboDetail {
       - soLuong : int
       - ghiChu : String
       --
       + getSoLuong() : int
    }
}

MenuUI -down-> MenuController
MenuController -down-> Category
MenuController -down-> MenuItem
Category "1" --down- "*" MenuItem
MenuItem <|--down- Dish
MenuItem <|--down- Combo
Combo "1" *-right- "1..*" ComboDetail
ComboDetail "*" -right-> "1" Dish


' ===================================================================
' NHOM 2: ORDER (chon ban/loai don -> dat mon -> tao don)
' ===================================================================
package "OrderPackage" {
    class TableSelectionUI {
       --
       + hienThiSoDoBan() : void
       + chonKhuVuc(khu: Area) : void
       + chonMotBan(ban: Table) : void
    }

    class OrderTakingUI {
       --
       + hienThiThucDon() : void
       + chonMon(item: MenuItem) : void
       + xacNhanDatMon() : void
    }

    class OrderManagementUI {
       --
       + hienThiMenuTuyChon() : void
       + hienThiFormHuyDon() : void
    }

    class OrderController {
       --
       + xacDinhLoaiDon(loai: String) : Order
       + ganBan(don: OrderTaiCho, ban: Table) : bool
       + themMonVaoDon(don: Order, item: MenuItem, soLuong: int) : bool
       + taoDon(don: Order) : bool
       + gopHoaDon(donA: Order, donB: Order) : Order
       + tachHoaDon(don: Order) : Order
       + huyDon(don: Order, lyDo: LyDoHuyDon) : bool
       + diChuyenBan(don: OrderTaiCho, banMoi: Table) : bool
    }

    class Area {
       - maKhuVuc : String
       - tenKhuVuc : String
    }

    class Table {
       - maBan : String
       - soBan : String
       - trangThai : TrangThaiBan
    }

    enum TrangThaiBan {
       TRONG
       DANG_PHUC_VU
    }

    class Order {
       # maDon : String
       # thoiGianTao : DateTime
       # trangThai : TrangThaiDon
       # tongTien : double
       # vat : double
       # chietKhau : double
       --
       + tinhTongTien() : double
    }

    class OrderTaiCho {
       - ban : Table
    }

    class OrderMangVe {
       - diaChiGiao : String
       - soDienThoaiKhach : String
    }

    enum TrangThaiDon {
       DANG_PHUC_VU
       CHO_THANH_TOAN
       DA_THANH_TOAN
       DA_HUY
    }

    class OrderItem {
       - soLuong : int
       - donGia : double
       - ghiChu : String
       - tuyChon : String
    }

    enum LyDoHuyDon {
       DOI_TRA_LAI
       THEM_NHAM_DON_HANG
       KHACH_BAO_HUY
       LY_DO_KHAC
    }
}

TableSelectionUI -down-> OrderController
OrderTakingUI -down-> OrderController
OrderManagementUI -down-> OrderController
OrderController -down-> Order
OrderController -down-> Table
OrderController ..down..> LyDoHuyDon
Area "1" --down- "*" Table
Table -right-> TrangThaiBan
Order <|--down- OrderTaiCho
Order <|--down- OrderMangVe
Order -right-> TrangThaiDon
Order "1" *-down- "1..*" OrderItem
OrderItem "*" -right-> "1" MenuItem
OrderTaiCho "1" --down- "1" Table


' ===================================================================
' NHOM 4: THANH TOAN
' ===================================================================
package "ThanhToanPackage" {
    class PaymentUI {
       --
       + hienThiDanhSachDonChoThanhToan() : void
       + chonPhuongThucThanhToan() : void
       + nhapSoTienNhan(soTien: double) : void
    }

    class PaymentController {
       --
       + chonDonThanhToan(don: Order) : Payment
       + chonPhuongThuc(loaiPt: String) : Payment
       + xuLyThanhToan(payment: Payment) : bool
       + xoaDonSauThanhToan(don: Order) : bool
       + luuLichSu(payment: Payment) : bool
    }

    class Payment {
       # maThanhToan : String
       # tongTienDon : double
       # thoiGianThanhToan : DateTime
       --
       + xacNhanThanhToan() : bool
    }

    class PaymentTienMat {
       - tienDaNhan : double
       - tienThua : double
       - tienTip : double
       --
       + tinhTienThua() : double
    }

    class PaymentThe {
       - loaiThe : LoaiThe
       - maGiaoDich : String
       --
       + xacThucThe() : bool
    }

    enum LoaiThe {
       VISA
       MASTER
       JCB
       ATM
    }

    class PaymentLog {
       - maLog : String
       - maDon : String
       - tongTien : double
       - thoiGian : DateTime
       - nhanVien : String
    }
}

PaymentUI -down-> PaymentController
PaymentController -down-> Payment
PaymentController -down-> Order
PaymentController -right-> PaymentLog
Payment <|--down- PaymentTienMat
Payment <|--down- PaymentThe
PaymentThe -right-> LoaiThe
Order "1" --down- "0..1" Payment
Payment "1" -right-> "1" PaymentLog

@enduml
