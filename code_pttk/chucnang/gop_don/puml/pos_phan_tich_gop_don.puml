@startuml

' =========================
' STYLE (VISUAL PARADIGM)
' =========================
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho

' Khoang cach deu giua cac bang
skinparam nodesep 65
skinparam ranksep 65

skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontColor #111111

' Chi ten class in dam
skinparam classFontStyle bold

skinparam class {
   BackgroundColor #7ACFF5
   BorderColor #000000
   BorderThickness 1

   FontColor #111111
   AttributeFontColor #111111

   ArrowColor #000000
   StereotypeFontColor #111111
}

skinparam package {
   BackgroundColor #FFFFFF
   BorderColor #000000
   BorderThickness 1
   FontStyle bold
}

hide circle
' An toan bo phuong thuc de dung chuan pha phan tich
hide methods

' ===================================================================
' CLASSES (ANALYSIS PHASE) - CHUC NANG: GOP DON HANG
' ===================================================================
package "OrderPackage" {
    class Table {
       - maBan
       - soBan
       - trangThai
    }

    class Order {
       - maDon
       - thoiGianTao
       - trangThai
       - tongTien
       - vat
       - chietKhau
    }

    class OrderTaiCho {
       - ban
    }

    class OrderItem {
       - soLuong
       - donGia
       - ghiChu
       - tuyChon
    }
}

' =========================
' ASSOCIATIONS
' =========================
Order <|--down- OrderTaiCho
Order "1" *-down- "1..*" OrderItem
OrderTaiCho "1" --down- "1" Table

@enduml
