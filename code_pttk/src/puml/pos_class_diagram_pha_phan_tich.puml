@startuml

' ===================================================================
' CLASS DIAGRAM - PHA PHAN TICH (ANALYSIS)
' Style: Visual Paradigm / Visual Diagram (vidu.puml)
' Chi gom cac lop thuc the (domain concept), khong Boundary/Control,
' khong phuong thuc, thuoc tinh rut gon (khong kieu du lieu / visibility)
' ===================================================================

' =========================
' STYLE
' =========================
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam linetype ortho

' Khoang cach deu giua cac bang
skinparam nodesep 65
skinparam ranksep 65

skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam defaultFontColor #111111

' Chi ten class in dam
skinparam classFontStyle bold

skinparam class {
   BackgroundColor #7ACFF5
   BorderColor #000000
   BorderThickness 1

   FontColor #111111
   AttributeFontColor #111111

   ArrowColor #000000
   StereotypeFontColor #111111
}

skinparam package {
   BackgroundColor #FFFFFF
   BorderColor #000000
   BorderThickness 1
   FontStyle bold
}

hide circle
' An toan bo phuong thuc de dung chuan pha phan tich
hide methods

' ===================================================================
' PACKAGE: MENU
' ===================================================================
package "MenuPackage" {
    class Category {
       - maDanhMuc
       - tenDanhMuc
       - moTa
    }

    abstract class MenuItem {
       - maMon
       - tenMon
       - gia
       - hinhAnh
       - dangKinhDoanh
    }

    class Dish {
       - loaiMon
       - moTa
    }

    class Combo {
       - soLuongNguoiAn
    }

    class ComboDetail {
       - soLuong
       - ghiChu
    }
}

Category "1" --down- "*" MenuItem
MenuItem <|--down- Dish
MenuItem <|--down- Combo
Combo "1" *-right- "1..*" ComboDetail
ComboDetail "*" -right-> "1" Dish


' ===================================================================
' PACKAGE: ORDER
' ===================================================================
package "OrderPackage" {
    class Area {
       - maKhuVuc
       - tenKhuVuc
    }

    class Table {
       - maBan
       - soBan
       - trangThai
    }

    class Order {
       - maDon
       - thoiGianTao
       - trangThai
       - tongTien
       - vat
       - chietKhau
    }

    class OrderTaiCho {
       - ban
    }

    class OrderMangVe {
       - diaChiGiao
       - soDienThoaiKhach
    }

    class OrderItem {
       - soLuong
       - donGia
       - ghiChu
       - tuyChon
    }
}

Area "1" --down- "*" Table
Order <|--down- OrderTaiCho
Order <|--down- OrderMangVe
Order "1" *-down- "1..*" OrderItem
OrderItem "*" -right-> "1" MenuItem
OrderTaiCho "1" --down- "1" Table


' ===================================================================
' PACKAGE: THANH TOAN
' ===================================================================
package "ThanhToanPackage" {
    class Payment {
       - maThanhToan
       - tongTienDon
       - thoiGianThanhToan
    }

    class PaymentTienMat {
       - tienDaNhan
       - tienThua
       - tienTip
    }

    class PaymentThe {
       - loaiThe
       - maGiaoDich
    }

    enum LoaiThe {
       VISA
       MASTER
       JCB
       ATM
    }

    class PaymentLog {
       - maLog
       - maDon
       - tongTien
       - thoiGian
       - nhanVien
    }
}

Payment <|--down- PaymentTienMat
Payment <|--down- PaymentThe
PaymentThe -right-> LoaiThe
Order "1" --down- "0..1" Payment
Payment "1" -right-> "1" PaymentLog

@enduml
